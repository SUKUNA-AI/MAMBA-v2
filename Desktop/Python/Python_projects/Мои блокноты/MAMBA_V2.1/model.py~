import torch
import torch.nn as nn
import torch.nn.functional as F
import pytorch_lightning as pl

from config import HybridConfig
from preprocessing import TelemetryPreprocessor
from hybrid_block import HybridBlock
from calibration_module import CalibrationModule
from uncertainty_module import UncertaintyHead

class PulpSieveModel(pl.LightningModule):
    def __init__(self, config=None, device='cuda', dtype=None):
        super().__init__()
        self.config = config or HybridConfig()  # Используем переданный config или дефолтный
        self.save_hyperparameters()

        factory_kwargs = {"device": device, "dtype": dtype}

        # Preprocessing
        self.preprocessor = TelemetryPreprocessor(
            input_dim=self.config.input_dim,
            output_dim=self.config.d_model,
            seq_len=self.config.seq_len,
            device=device,
            dtype=dtype
        )

        # Stack of hybrid blocks
        self.blocks = nn.ModuleList([
            HybridBlock(
                dim=self.config.d_model,
                d_intermediate=self.config.d_intermediate,
                dropout=self.config.dropout,
                norm_epsilon=self.config.norm_epsilon,
                config=self.config,
                **factory_kwargs
            ) for _ in range(self.config.n_layer)
        ])

        # Final layer normalization
        self.norm_f = nn.LayerNorm(self.config.d_model, eps=self.config.norm_epsilon, **factory_kwargs)

        # Calibration module
        self.calibration = CalibrationModule(
            d_model=self.config.d_model,
            lab_feature_dim=self.config.lab_feature_dim,
            dropout=self.config.dropout,
            **factory_kwargs
        )

        # Output head
        if self.config.estimate_uncertainty:
            self.output_head = UncertaintyHead(
                d_model=self.config.d_model,
                output_dim=self.config.output_dim,
                dropout=self.config.dropout,
                **factory_kwargs
            )
        else:
            self.output_head = nn.Sequential(
                nn.Linear(self.config.d_model, self.config.d_model // 2, **factory_kwargs),
                nn.LayerNorm(self.config.d_model // 2, eps=1e-5, **factory_kwargs),
                nn.Dropout(self.config.dropout),
                nn.GELU(),
                nn.Linear(self.config.d_model // 2, self.config.output_dim, **factory_kwargs)
            )

    def forward(self, telemetry_data, lab_data=None):
        """
        Forward pass for the model.

        Args:
            telemetry_data: Telemetry data tensor [batch, seq_len, input_dim]
            lab_data: Laboratory data tensor [batch, lab_feature_dim] or None

        Returns:
            If estimate_uncertainty is True:
                Tuple of (mean, variance) tensors [batch, output_dim]
            Else:
                Output tensor [batch, output_dim]
        """
        # Preprocess telemetry data
        x = self.preprocessor(telemetry_data, update_stats=self.training)
        if torch.isnan(x).any() or torch.isinf(x).any():
            print(f"После preprocessor: x содержит nan или inf: {x}")

        # Apply hybrid blocks
        for block in self.blocks:
            x = block(x)
            if torch.isnan(x).any() or torch.isinf(x).any():
                print(f"После блока: x содержит nan или inf: {x}")

        # Apply final normalization
        x = self.norm_f(x)
        if torch.isnan(x).any() or torch.isinf(x).any():
            print(f"После norm_f: x содержит nan или inf: {x}")

        # Attention-weighted pooling over sequence dimension
        attention_weights = torch.softmax(x.mean(dim=-1), dim=1)  # [batch, seq_len]
        if torch.isnan(attention_weights).any() or torch.isinf(attention_weights).any():
            print(f"attention_weights содержит nan или inf: {attention_weights}")
        x = torch.bmm(attention_weights.unsqueeze(1), x).squeeze(1)  # [batch, d_model]
        if torch.isnan(x).any() or torch.isinf(x).any():
            print(f"После bmm: x содержит nan или inf: {x}")

        # Apply calibration if laboratory data is available
        x = self.calibration(x, lab_data)
        if torch.isnan(x).any() or torch.isinf(x).any():
            print(f"После calibration: x содержит nan или inf: {x}")

        # Apply output head
        if self.config.estimate_uncertainty:
            mean, var = self.output_head(x)
            if torch.isnan(mean).any() or torch.isinf(mean).any() or torch.isnan(var).any() or torch.isinf(var).any():
                print(f"mean={mean}, var={var} содержит nan или inf")
            return mean, var
        else:
            output = self.output_head(x)
            if torch.isnan(output).any() or torch.isinf(output).any():
                print(f"output={output} содержит nan или inf")
            return output

    def training_step(self, batch, batch_idx):
        """
        Training step.

        Args:
            batch: Tuple of (telemetry_data, lab_data, target)
            batch_idx: Batch index

        Returns:
            Loss scalar
        """
        telemetry_data, lab_data, target = batch

        # Проверка входных данных
        if torch.isnan(telemetry_data).any() or torch.isinf(telemetry_data).any():
            print("Найдены nan или inf в telemetry_data")
        if lab_data is not None and (torch.isnan(lab_data).any() or torch.isinf(lab_data).any()):
            print("Найдены nan или inf в lab_data")
        if torch.isnan(target).any() or torch.isinf(target).any():
            print("Найдены nan или inf в target")

        if self.config.estimate_uncertainty:
            mean, var = self(telemetry_data, lab_data)
            # Гарантируем, что var > 0
            var = F.softplus(var)
            loss = self.output_head.loss(mean, var, target)
            rmse = torch.sqrt(F.mse_loss(mean, target))
            # Защита от nan
            if torch.isnan(loss) or torch.isinf(loss):
                loss = torch.tensor(float('inf'), device=loss.device)
            if torch.isnan(rmse) or torch.isinf(rmse):
                rmse = torch.tensor(float('inf'), device=rmse.device)
            self.log('train_loss', loss)
            self.log('train_rmse', rmse)
            return loss
        else:
            output = self(telemetry_data, lab_data)
            loss = F.mse_loss(output, target)
            rmse = torch.sqrt(loss)
            if torch.isnan(loss) or torch.isinf(loss):
                loss = torch.tensor(float('inf'), device=loss.device)
            if torch.isnan(rmse) or torch.isinf(rmse):
                rmse = torch.tensor(float('inf'), device=rmse.device)
            self.log('train_loss', loss)
            self.log('train_rmse', rmse)
            return loss

