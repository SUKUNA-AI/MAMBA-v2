            self.log('val_rmse', rmse)

    def test_step(self, batch, batch_idx):
        """
        Test step.

        Args:
            batch: Tuple of (telemetry_data, lab_data, target)
            batch_idx: Batch index
        """
        telemetry_data, lab_data, target = batch

        if self.config.estimate_uncertainty:
            mean, var = self(telemetry_data, lab_data)
            var = F.softplus(var)
            loss = self.output_head.loss(mean, var, target)
            rmse = torch.sqrt(F.mse_loss(mean, target))
            if torch.isnan(loss) or torch.isinf(loss):
                loss = torch.tensor(float('inf'), device=loss.device)
            if torch.isnan(rmse) or torch.isinf(rmse):
                rmse = torch.tensor(float('inf'), device=rmse.device)
            self.log('test_loss', loss)
